{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "serac",
  "description": "Workspace root for the Serac ServiceNow MCP server and its skill guides.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "bun turbo typecheck",
    "test": "bun turbo test",
    "test:ci": "bun turbo test:ci",
    "lint": "oxlint",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check ."
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "form-data": "4.0.6",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.9.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/serac-labs/serac"
  },
  "license": "Apache-2.0",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "dependencies": {
    "form-data": "4.0.6"
  }
}
