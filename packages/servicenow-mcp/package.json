{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@serac-labs/servicenow-mcp",
  "version": "0.2.1",
  "description": "Unified ServiceNow MCP server (437 snow_* tools), blast-radius analysis, stdio + HTTP transports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serac-labs/serac.git"
  },
  "homepage": "https://serac.build",
  "bugs": {
    "url": "https://github.com/serac-labs/serac/issues"
  },
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "src/agent-fragments"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./agent-fragments/*": "./src/agent-fragments/*",
    "./server": "./src/servicenow-mcp-unified/shared/server-factory.ts",
    "./http": "./src/servicenow-mcp-unified/transports/http.ts",
    "./stdio": "./src/servicenow-mcp-unified/transports/stdio.ts",
    "./enterprise-proxy": "./src/enterprise-proxy/index.ts",
    "./blast-radius": "./src/servicenow-mcp-unified/tools/blast-radius/index.ts",
    "./types": "./src/servicenow-mcp-unified/shared/types.ts",
    "./auth": "./src/servicenow-mcp-unified/shared/auth.ts",
    "./error-handler": "./src/servicenow-mcp-unified/shared/error-handler.ts",
    "./serac-home": "./src/servicenow-mcp-unified/shared/serac-home.ts",
    "./mcp-debug": "./src/shared/mcp-debug.ts",
    "./cli/enterprise-docs-generator": "./src/cli/enterprise-docs-generator.ts"
  },
  "bin": {
    "servicenow-mcp-stdio": "./src/servicenow-mcp-unified/index.ts",
    "servicenow-mcp-enterprise-proxy": "./src/enterprise-proxy/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test": "bun test",
    "test:ci": "mkdir -p .artifacts/unit && bun test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml",
    "generate:tools-json": "bun script/generate-tools-json.ts",
    "generate:tools-json:check": "bun script/generate-tools-json.ts --check",
    "probe:sn-roles": "bun script/probe-sn-roles/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "axios": "1.18.0",
    "dotenv": "17.2.3",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "node-machine-id": "1.1.12",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@jest/globals": "^29",
    "@types/bun": "1.3.13",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "typescript": "5.8.2"
  }
}
